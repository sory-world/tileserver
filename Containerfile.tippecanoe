ARG TIPPECANOE_REF=main

FROM debian:bookworm-slim AS build
ARG TIPPECANOE_REF

# Build dependencies required by Tippecanoe
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    git \
    libsqlite3-dev \
    make \
    zlib1g-dev \
  && rm -rf /var/lib/apt/lists/*

# Fetch Tippecanoe ref
RUN git clone https://github.com/felt/tippecanoe.git /src \
  && cd /src \
  && git checkout "${TIPPECANOE_REF}"

WORKDIR /src

# Install Tippecanoe (nproc is used to parallelize the build)
RUN make -j"$(nproc)" && make install

FROM debian:bookworm-slim

# Runtime libs for compiled Tippecanoe binaries
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libsqlite3-0 \
    zlib1g \
  && rm -rf /var/lib/apt/lists/*

# Make install places Tippecanoe binaries in /usr/local/bin
COPY --from=build /usr/local/bin/tippecanoe* /usr/local/bin/
COPY --from=build /usr/local/bin/tile-join /usr/local/bin/

WORKDIR /work
ENTRYPOINT ["tippecanoe"]
